package components

templ Navbar() {
	<header class="navbar" id="navbar">
		<div class="navbar__container">
			<a href="/" class="navbar__brand">
				RHYRED<span class="navbar__brand-dot">.</span>
			</a>
			<nav class="navbar__nav" id="navbar-nav" aria-label="Main navigation">
				<ul class="navbar__list">
					<li><a href="/" class="navbar__link">Home</a></li>
					<li><a href="/about" class="navbar__link">About</a></li>
					<li><a href="/projects" class="navbar__link">Projects</a></li>
					<li><a href="/lab" class="navbar__link">Digital Lab</a></li>
					<li><a href="/journal" class="navbar__link">Journal</a></li>
					<li><a href="#contact" class="navbar__link">Contact</a></li>
				</ul>
			</nav>
			<button class="navbar__toggle" id="navbar-toggle" aria-label="Toggle navigation" aria-expanded="false">
				<span class="navbar__toggle-bar"></span>
				<span class="navbar__toggle-bar"></span>
				<span class="navbar__toggle-bar"></span>
			</button>
		</div>
	</header>
}

